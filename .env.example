DOMAIN=panel.example.com
WEBAPP_URL=https://panel.example.com/app/
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgresql+psycopg://control:replace-with-long-random-password@postgres:5432/control
CONTROL_API_KEY=replace-with-64-random-hex-characters
TELEGRAM_BOT_TOKEN=
ROOT_TELEGRAM_ID=123456789
TELEGRAM_WEBHOOK_SECRET=replace-with-64-random-hex-characters
APP_ENCRYPTION_KEY=replace-with-64-random-hex-characters
INITIAL_SETUP_TOKEN=replace-with-64-random-hex-characters
# /metrics returns 503 until this is set; send it as the X-Metrics-Token header.
METRICS_TOKEN=replace-with-64-random-hex-characters
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=120
# Set to 1 only behind a reverse proxy that rewrites X-Forwarded-For.
TRUST_PROXY_HEADERS=0
# /docs stays closed in production; set to 1 for a private debugging window.
EXPOSE_DOCS=0
REDIS_URL=redis://redis:6379/0
USAGE_POLL_SECONDS=30
# Deepest reseller level that may be created below the root organization.
MAX_TREE_DEPTH=5
# Seconds an adjustment request stays decidable before it expires unused.
APPROVAL_TTL_SECONDS=604800
# Byte ceiling applied to a suspended organization's PasarGuard admin.
HOLD_LIMIT_BYTES=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=2G
API_CPU_LIMIT=0.75
API_MEMORY_LIMIT=1G
API_REPLICAS=1
API_WORKERS=1
TELEGRAM_CONSUMER_REPLICAS=1
# Number of scripts/backup.sh archives kept before the oldest is removed.
BACKUP_RETENTION=30
