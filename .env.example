DOMAIN=panel.example.com
WEBAPP_URL=https://panel.example.com/app/
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgresql+psycopg://control:replace-with-long-random-password@postgres:5432/control
CONTROL_API_KEY=replace-with-64-random-hex-characters
TELEGRAM_BOT_TOKEN=
ROOT_TELEGRAM_ID=123456789
TELEGRAM_WEBHOOK_SECRET=replace-with-64-random-hex-characters
APP_ENCRYPTION_KEY=replace-with-64-random-hex-characters
INITIAL_SETUP_TOKEN=replace-with-64-random-hex-characters
REDIS_URL=redis://redis:6379/0
USAGE_POLL_SECONDS=30
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
POSTGRES_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=2G
API_CPU_LIMIT=0.75
API_MEMORY_LIMIT=1G
API_REPLICAS=1
API_WORKERS=1
TELEGRAM_CONSUMER_REPLICAS=1
